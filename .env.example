# Copy to .env. The default profile needs NO external keys.
# Authoritative variable list and defaults: REQUIREMENTS.md section 9.2

# --- Profile: mock | record | replay | live ---------------------------------
DISCOVER_PROFILE=mock
# Per-provider overrides (optional; default: inherit DISCOVER_PROFILE)
# QLOO_MODE=
# LLM_MODE=
# SEARCH_MODE=
# STT_MODE=
# Production refuses the mock profile unless this is true (all output labelled demo)
ALLOW_DEMO_MODE=false

# --- Qloo -------------------------------------------------------------------
QLOO_API_KEY=
QLOO_BASE_URL=
QLOO_CACHE_TTL_SECONDS=3600

# --- LLM (OpenAI-compatible endpoint with tool-calling) ---------------------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Current-information search (optional) ----------------------------------
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Speech-to-text fallback (optional) -------------------------------------
STT_PROVIDER=
STT_API_KEY=

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://discover:discover@localhost:5432/discover

# --- Auth -------------------------------------------------------------------
GUEST_JWT_SECRET=change-me-in-real-environments
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# --- Web --------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
FEATURE_FLAGS=

# --- Agent and run limits ---------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_AUTO_REFINEMENTS=2
RUN_TOTAL_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=20
RUN_SYNC_WAIT_SECONDS=25
SSE_HEARTBEAT_SECONDS=15

# --- Retention --------------------------------------------------------------
RUN_EVENT_RETENTION_DAYS=30
GUEST_RETENTION_DAYS=30
SOFT_DELETE_PURGE_DAYS=14

# --- Rate limits and input bounds -------------------------------------------
RATE_LIMIT_MESSAGES_PER_HOUR=60
RATE_LIMIT_PUBLIC_PER_MINUTE=30
MAX_MESSAGE_CHARS=4000
MAX_PARTICIPANTS=12

# --- Export bounds ----------------------------------------------------------
EXPORT_MAX_SECONDS=30
EXPORT_MAX_MB=25
