# ===== Discover backend environment =====
# Copy to .env for local development. In production set these in your host's dashboard (Render), never commit them.

# --- App ---
APP_ENV=development                 # production in deployment (then SECRET_KEY is mandatory)
SECRET_KEY=                         # long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
DATABASE_URL=sqlite:///./discover.db   # production: your Postgres URL (Neon/Supabase/Aiven); postgres:// URLs are accepted
CORS_ORIGINS=http://localhost:5173  # comma list: your frontend origin(s), e.g. https://discover.vercel.app
ALLOW_SIGNUP=true                   # false to close registration
MAX_RUNS_PER_DAY=10                 # per user
TOKEN_MINUTES=10080                 # login lifetime (7 days)
RUNS_DIR=/tmp/discover-runs         # scratch space for the engine's run folders (deleted after each run)
DISCOVER_MOCK=false                 # true = offline mock Qloo/LLM (demos without keys)

# --- Qloo (required for real analyses) ---
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- LLM (any OpenAI-compatible provider) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Optional: other models on the same provider, tried in order when the main one fails or its daily quota is spent
# LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b
LLM_DELAY_SECONDS=8                 # pause between LLM calls; needed on Groq's free token-per-minute limits
LLM_TIMEOUT_SECONDS=90

# --- Exploring agent (optional) ---
AGENT_ENABLED=true
AGENT_LLM_MODEL=                    # a different model for the agent (separate quota); empty = use LLM_MODEL
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=

# Keep each run's folder (every Qloo call, model exchange, evidence and the market ledger) under RUNS_DIR. Debugging only.
# KEEP_RUNS=true
# RUNS_DIR=./runs

# Apply pending database migrations when the API starts (default true). Set false to run `alembic upgrade head` yourself.
# AUTO_MIGRATE=true

# Ceiling on Qloo calls per analysis. A lean run uses about 20 to 26, so 40 leaves room for a market-map run.
# ENGINE_MODE=lean            # lean: about 25 Qloo calls per analysis. full: the older per-segment mode, about 50 calls
# ADMIN_EMAILS=you@example.com   # comma separated; these accounts see the Admin page
# MAX_QLOO_CALLS=            # empty = 40 in lean mode, 150 in full mode

# Google sign-in: the OAuth "Web application" client id from Google Cloud Console (APIs & Services > Credentials).
# Authorised JavaScript origins must include your front-end URL. Leave empty to turn the Google button off.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
