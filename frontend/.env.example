# Leave empty in local dev (Vite proxies /api to localhost:8000).
# On Vercel set this to your Render URL, e.g. https://discover-api.onrender.com
VITE_API_URL=

# Shown in the footer. Leave the email empty to hide it.
VITE_TEAM_NAME=
VITE_CONTACT_EMAIL=

# Google sign-in: the same OAuth client id the API has in GOOGLE_CLIENT_ID. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
